{
  "name": "TP-final",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "contracts:generate": "pnpm --filter @escrow/contracts generate",
    "contracts:check": "pnpm --filter @escrow/contracts check",
    "web:typecheck": "pnpm --filter @escrow/web typecheck",
    "web:test": "pnpm --filter @escrow/web test",
    "web:build": "pnpm --filter @escrow/web build",
    "web:dev": "pnpm --filter @escrow/web dev",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,json,html}\" \"packages/contracts/**/*.{js,mjs,json}\" package.json pnpm-workspace.yaml .prettierrc.json --ignore-unknown",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,json,html}\" \"packages/contracts/**/*.{js,mjs,json}\" package.json pnpm-workspace.yaml .prettierrc.json --ignore-unknown",
    "verify": "pnpm hardhat build && pnpm hardhat test && pnpm contracts:check && pnpm web:typecheck && pnpm web:test && pnpm format && pnpm web:build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.11.1",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.3.1",
    "typescript": "~6.0.3"
  }
}
